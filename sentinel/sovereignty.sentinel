import "tfplan/v2" as tfplan

approved_regions = ["eu-west-1"]

aws_resources = filter tfplan.planned_values.resources as _, resource {
    resource.provider_name is "registry.terraform.io/hashicorp/aws"
}

main = rule {
    length(aws_resources) > 0 and
    tfplan.variables.aws_region.value in approved_regions and
    all aws_resources as _, resource {
        resource.values.region in approved_regions
    }
}