import "tfconfig/v2" as tfconfig

# Approved provider source and version constraint
approved_source = "registry.terraform.io/hashicorp/aws"
approved_version_constraint = "~> 6.71.0"

providers = tfconfig.providers

main = rule {
	length(providers) > 0 and
	all providers as _, provider {
		provider.full_name is approved_source and
			provider.version_constraint is approved_version_constraint
	}
}
